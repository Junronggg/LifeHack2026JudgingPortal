{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lifehack2026judgingportal",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-08-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "secrets": {
    "required": [
      "USERS_JSON",
      "SESSION_SECRET",
      "SHEETS_WEB_APP_URL",
      "SHEETS_SHARED_SECRET"
    ]
  },
  "vars": {
    "MIN_JUDGES": "3"
  }
}
