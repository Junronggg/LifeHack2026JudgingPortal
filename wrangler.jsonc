{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lifehack2026judgingportal",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-08-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "MIN_JUDGES": "1",
    "DEMO_MODE": "true"
  }
}
